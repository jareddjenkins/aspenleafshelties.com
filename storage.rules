rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in [
          "jareddjenkins@gmail.com",
          "aspenleafshelties@gmail.com"
        ];
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
