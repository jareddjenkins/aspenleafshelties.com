{
  "name": "aspenleafshelties",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "docker:prod:build": "docker compose build frontend-local",
    "docker:prod:up": "docker compose up frontend-local",
    "docker:prod:down": "docker compose down",
    "docker:dev:up": "docker compose up frontend-dev",
    "docker:dev:down": "docker compose down",
    "dev:ssr": "ng run aspenleafshelties:serve-ssr",
    "serve:ssr": "node dist/aspenleafshelties/server/main.js",
    "build:ssr": "ng build && ng run aspenleafshelties:server",
    "prerender": "ng run aspenleafshelties:prerender",
    "build:hosting": "npm run prerender"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.5.1",
    "@angular/animations": "^21.2.5",
    "@angular/cdk": "^21.2.3",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/material": "^21.2.3",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-browser-dynamic": "^21.2.5",
    "@angular/platform-server": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@angular/ssr": "^21.2.3",
    "express": "^5.1.0",
    "firebase": "^12.7.0",
    "ngx-image-cropper": "^9.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.3",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/cli": "~21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@angular/localize": "^21.2.5",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "browser-sync": "^3.0.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "firebase-admin": "^13.5.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "prettier": "^3.0.3",
    "prettier-eslint": "^16.1.2",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3"
  }
